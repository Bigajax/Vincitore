# ---------------------------------------------------------------------------
# VINCITORE — copie para .env.local e preencha
# ---------------------------------------------------------------------------

# URL pública do site (usada no sitemap, no OG e no link que vai na mensagem
# do WhatsApp). Sem barra no fim.
NEXT_PUBLIC_SITE_URL=https://vincitore.com.br

# WhatsApp que recebe os pedidos. Só dígitos: DDI + DDD + número.
NEXT_PUBLIC_WHATSAPP_NUMERO=5551989431465

# ---------------------------------------------------------------------------
# MODO LOCAL (padrão — sem Supabase)
# ---------------------------------------------------------------------------
# O catálogo vive em .dados/banco.json e as fotos em public/uploads/.
# O painel entra só com senha. NÃO funciona na Vercel (disco somente leitura).
# Defina uma senha aqui: sem ela o código cai num padrão de desenvolvimento.

ADMIN_SENHA=
# Segredo que assina o cookie de sessão. Troque por algo aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SEGREDO=

# ---------------------------------------------------------------------------
# MODO SUPABASE (produção)
# ---------------------------------------------------------------------------
# Preencher as DUAS variáveis abaixo liga o modo Supabase automaticamente:
# catálogo no Postgres, fotos no bucket `produtos` e login por e-mail + senha.
# Antes, rode supabase/schema.sql no SQL Editor (ver README).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
